<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow fixed-tablet menu row; regular phone menu_item.xml is unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="32dp"
    android:paddingStart="3dp"
    android:paddingEnd="3dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:background="?attr/selectableItemBackground">

    <com.tbd.forkfront.window.text.NH_TextView
        android:id="@+id/item_acc"
        app:useFittedSize="false"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:gravity="top|center_horizontal"
        android:textColor="#E4E5E8"
        android:textSize="12sp"
        android:includeFontPadding="false" />

    <ImageView
        android:id="@+id/item_tile"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="2dp"
        android:contentDescription="Item symbol"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <com.tbd.forkfront.window.text.NH_TextView
            android:id="@+id/item_text"
            app:useFittedSize="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#E4E5E8"
            android:lineSpacingExtra="0dp"
            android:includeFontPadding="false"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none" />

        <com.tbd.forkfront.window.text.NH_TextView
            android:id="@+id/item_sub"
            app:useFittedSize="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#ABB0BC"
            android:lineSpacingExtra="0dp"
            android:includeFontPadding="false"
            android:visibility="gone" />
    </LinearLayout>

    <com.tbd.forkfront.window.text.NH_TextView
        android:id="@+id/item_count"
        app:useFittedSize="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#E4E5E8"
        android:includeFontPadding="false" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/item_check"
        android:layout_width="32dp"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:focusable="false"
        android:clickable="false"
        android:visibility="gone" />
</LinearLayout>
